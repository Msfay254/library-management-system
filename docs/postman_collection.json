{
"info": {"name":"Library Management System API","description":"Run top to bottom. Log in first, then genres, books, and profile. Librarian routes use the seeded librarian account. Login is limited to 5 attempts per minute.","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
"variable": [{"key":"baseUrl","value":"http://localhost:3000"},{"key":"patronToken","value":""},{"key":"librarianToken","value":""},{"key":"genreId","value":""},{"key":"bookId","value":""}],
"item": [
{"name":"Auth","item":[
{"name":"Register (new patron)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/auth/register","host":["{{baseUrl}}"],"path":["auth","register"],"query":[]},"body":{"mode":"raw","raw":"{\n  \"email\": \"newreader@example.com\",\n  \"password\": \"Reader1234!\"\n}","options":{"raw":{"language":"json"}}}}},
{"name":"Login (patron)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/auth/login","host":["{{baseUrl}}"],"path":["auth","login"],"query":[]},"body":{"mode":"raw","raw":"{\n  \"email\": \"patron@example.com\",\n  \"password\": \"Patron123!\"\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Login succeeds', () => pm.response.to.have.status(200));","pm.collectionVariables.set('patronToken', pm.response.json().access_token);"]}}]},
{"name":"Login (librarian)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/auth/login","host":["{{baseUrl}}"],"path":["auth","login"],"query":[]},"body":{"mode":"raw","raw":"{\n  \"email\": \"librarian@example.com\",\n  \"password\": \"Librarian123!\"\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Login succeeds', () => pm.response.to.have.status(200));","pm.collectionVariables.set('librarianToken', pm.response.json().access_token);"]}}]}
]},
{"name":"Genres","item":[
{"name":"List genres","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/genres","host":["{{baseUrl}}"],"path":["genres"],"query":[]}}},
{"name":"Create genre (librarian)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/genres","host":["{{baseUrl}}"],"path":["genres"],"query":[]},"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{librarianToken}}","type":"string"}]},"body":{"mode":"raw","raw":"{\n  \"name\": \"Poetry\"\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Created', () => pm.response.to.have.status(201));","pm.collectionVariables.set('genreId', pm.response.json().id);"]}}]},
{"name":"Get genre by id","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/genres/{{genreId}}","host":["{{baseUrl}}"],"path":["genres","{{genreId}}"],"query":[]}}},
{"name":"Update genre (librarian)","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/genres/{{genreId}}","host":["{{baseUrl}}"],"path":["genres","{{genreId}}"],"query":[]},"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{librarianToken}}","type":"string"}]},"body":{"mode":"raw","raw":"{\n  \"name\": \"Poetry and Verse\"\n}","options":{"raw":{"language":"json"}}}}}
]},
{"name":"Books","item":[
{"name":"List books (paginated)","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/books?page=1&limit=5","host":["{{baseUrl}}"],"path":["books"],"query":[{"key":"page","value":"1"},{"key":"limit","value":"5"}]}}},
{"name":"Create book (librarian)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/books","host":["{{baseUrl}}"],"path":["books"],"query":[]},"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{librarianToken}}","type":"string"}]},"body":{"mode":"raw","raw":"{\n  \"title\": \"Collected Poems\",\n  \"author\": \"Sample Author\",\n  \"isbn\": \"9781234567897\",\n  \"totalCopies\": 3,\n  \"genreId\": {{genreId}}\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Created', () => pm.response.to.have.status(201));","pm.collectionVariables.set('bookId', pm.response.json().id);"]}}]},
{"name":"Filter books by genre","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/books?genreId={{genreId}}","host":["{{baseUrl}}"],"path":["books"],"query":[{"key":"genreId","value":"{{genreId}}"}]}}},
{"name":"Search books by title or author","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/books?search=le guin","host":["{{baseUrl}}"],"path":["books"],"query":[{"key":"search","value":"le guin"}]}}},
{"name":"Get book by id","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/books/{{bookId}}","host":["{{baseUrl}}"],"path":["books","{{bookId}}"],"query":[]}}},
{"name":"Update book (librarian)","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/books/{{bookId}}","host":["{{baseUrl}}"],"path":["books","{{bookId}}"],"query":[]},"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{librarianToken}}","type":"string"}]},"body":{"mode":"raw","raw":"{\n  \"totalCopies\": 5\n}","options":{"raw":{"language":"json"}}}}},
{"name":"Create book as patron (expect 403)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/books","host":["{{baseUrl}}"],"path":["books"],"query":[]},"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{patronToken}}","type":"string"}]},"body":{"mode":"raw","raw":"{\n  \"title\": \"Not Allowed\",\n  \"author\": \"Patron\",\n  \"isbn\": \"9781234567804\",\n  \"totalCopies\": 1,\n  \"genreId\": {{genreId}}\n}","options":{"raw":{"language":"json"}}}}},
{"name":"Delete book (librarian)","request":{"method":"DELETE","header":[],"url":{"raw":"{{baseUrl}}/books/{{bookId}}","host":["{{baseUrl}}"],"path":["books","{{bookId}}"],"query":[]},"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{librarianToken}}","type":"string"}]}}}
]},
{"name":"Genres (cleanup)","item":[
{"name":"Delete genre (librarian)","request":{"method":"DELETE","header":[],"url":{"raw":"{{baseUrl}}/genres/{{genreId}}","host":["{{baseUrl}}"],"path":["genres","{{genreId}}"],"query":[]},"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{librarianToken}}","type":"string"}]}}}
]},
{"name":"Users","item":[
{"name":"Get my profile","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/users/profile","host":["{{baseUrl}}"],"path":["users","profile"],"query":[]},"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{patronToken}}","type":"string"}]}}}
]}
]
}
